#!/usr/bin/env python3
"""
Add, list, or remove Git worktrees beside the main repo.

Path: <parent>/<repo_basename>-<branch with each / as ->
After add: runs git-sub when found (see --help), else built-in submodule init.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

PROG = "git-worktree"

USAGE = f"""Usage: {PROG} add <branch>
       {PROG} list|ls
       {PROG} remove|rm <branch>
Try '{PROG} --help' for more."""

HELP = f"""Usage:
  {PROG} add <branch>          Create a linked worktree for <branch>
  {PROG} list|ls               List linked worktrees (and rm <name> hints)
  {PROG} remove|rm <branch>    Remove that worktree (uses git worktree remove -f)

Worktree path:
  Next to the current repo: <parent>/<basename(repo)>-<branch name with slashes as hyphens>

About <branch>:
  On add, <branch> is a real Git branch name (or a new branch name to create): it
  selects what to check out and also sets the directory suffix above.

  On remove, <branch> is that directory suffix (after `<repo>-`). It is not
  "whatever branch is checked out now" in the worktree. `{PROG} ls` prints the
  usable names after the normal git listing.

  If you rename the worktree directory by hand, this script will not find it
  unless you pass a name that still matches the folder suffix (or use another tool).

After add — submodule / LFS setup (first match wins):
  1. GIT_SUB environment variable points at a git-sub script (Python or other).
  2. Otherwise: git-sub on your PATH.
  3. Otherwise: sibling clone …/git-sub/git-sub next to this repo's directory
     (same parent folder as …/git-worktree/). Zero install if you clone both repos
     side by side with the default folder names.
  4. Otherwise: built-in fallback — git submodule update --init --recursive only.

After add — local symlink setup:
  Recreates symlinks that point outside the repo when the same link is present
  in the source worktree and at least one other existing worktree. This is meant
  for ignored personal config such as CMakeUserPresets.json, .run, or
  .idea/runConfigurations. For the first added worktree only, bootstraps from
  ignored external symlinks in the source worktree. Common generated directories
  such as venv, .venv, node_modules, and cmake-build-* are pruned while scanning.

remove uses -f so teardown works with dirty trees and submodule checkouts.

Platforms:
  Needs Python 3 and git on PATH. On Windows, run e.g.:
    python path\\to\\{PROG} add <branch>
  or put this file in a directory on PATH and associate/run with python3.
"""

PRUNE_SYMLINK_SCAN_DIR_NAMES = {
    ".cache",
    ".git",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".scannerwork",
    ".venv",
    "__pycache__",
    "node_modules",
    "venv",
}
PRUNE_SYMLINK_SCAN_DIR_PREFIXES = ("cmake-build-", "_build")
MIN_SHARED_SYMLINK_WORKTREES = 2
SYSTEM_SYMLINK_TARGET_ROOTS = tuple(
    Path(path)
    for path in (
        "/Applications",
        "/Library",
        "/System",
        "/bin",
        "/lib",
        "/lib64",
        "/opt/homebrew",
        "/opt/local",
        "/sbin",
        "/usr",
    )
)


class ExternalSymlink(NamedTuple):
    relpath: Path
    raw_target: str
    resolved_target: Path


def die(msg: str) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def git_output(args: list[str]) -> str:
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    if r.returncode != 0:
        die("Error: not a git repository (or git failed)")
    return r.stdout.strip()


def ref_exists(ref: str) -> bool:
    r = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", ref],
        capture_output=True,
    )
    return r.returncode == 0


def git_run(args: list[str], *, cwd: Path | None = None) -> None:
    r = subprocess.run(["git", *args], cwd=cwd)
    if r.returncode != 0:
        raise SystemExit(r.returncode)


def repo_root() -> Path:
    return Path(git_output(["rev-parse", "--show-toplevel"]))


def git_worktree_roots() -> list[Path]:
    roots: list[Path] = []
    for line in git_output(["worktree", "list", "--porcelain"]).splitlines():
        if line.startswith("worktree "):
            roots.append(Path(line[len("worktree ") :]))
    return roots


def managed_remove_name(root: Path, worktree: Path) -> str | None:
    """Folder suffix for `{PROG} rm`, or None if not this tool's path scheme."""
    root = root.resolve(strict=False)
    worktree = worktree.resolve(strict=False)
    if worktree == root:
        return None
    prefix = f"{root.name}-"
    if worktree.parent != root.parent or not worktree.name.startswith(prefix):
        return None
    suffix = worktree.name[len(prefix) :]
    return suffix or None


def managed_remove_names(root: Path, roots: list[Path] | None = None) -> list[str]:
    if roots is None:
        roots = git_worktree_roots()
    return [n for p in roots if (n := managed_remove_name(root, p)) is not None]


def unmanaged_worktrees(root: Path, roots: list[Path] | None = None) -> list[Path]:
    if roots is None:
        roots = git_worktree_roots()
    root_r = root.resolve(strict=False)
    return [
        p
        for p in roots
        if managed_remove_name(root, p) is None and p.resolve(strict=False) != root_r
    ]


def print_rm_hint(
    root: Path,
    roots: list[Path] | None = None,
    *,
    file=None,
) -> None:
    if file is None:
        file = sys.stdout
    if roots is None:
        roots = git_worktree_roots()
    names = managed_remove_names(root, roots)
    foreign = unmanaged_worktrees(root, roots)
    print(
        f"rm <name> uses the folder suffix after '{root.name}-' "
        f"(not the checked-out branch).",
        file=file,
    )
    if names:
        print("  " + "  ".join(f"rm {n}" for n in names), file=file)
    else:
        print("  (no managed worktrees)", file=file)
    print("not managed — use: git worktree remove -f <path>", file=file)
    if foreign:
        for path in foreign:
            print(f"  {path}", file=file)
    else:
        print("  (none)", file=file)


def is_git_ignored(root: Path, relpath: Path) -> bool:
    r = subprocess.run(
        ["git", "check-ignore", "--quiet", "--", relpath.as_posix()],
        cwd=root,
    )
    return r.returncode == 0


def worktree_path(root: Path, branch: str) -> Path:
    suffix = branch.replace("/", "-")
    return root.parent / f"{root.name}-{suffix}"


def is_within(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def resolved_symlink_target(link: Path, raw_target: str) -> Path:
    target = Path(raw_target)
    if not target.is_absolute():
        target = link.parent / target
    return target.resolve(strict=False)


def should_prune_symlink_scan_dir(path: Path) -> bool:
    name = path.name
    if name in PRUNE_SYMLINK_SCAN_DIR_NAMES:
        return True
    if any(name.startswith(prefix) for prefix in PRUNE_SYMLINK_SCAN_DIR_PREFIXES):
        return True
    return (path / "pyvenv.cfg").is_file()


def maybe_external_symlink(root_resolved: Path, link: Path) -> ExternalSymlink | None:
    raw_target = os.readlink(link)
    resolved_target = resolved_symlink_target(link, raw_target)
    if is_within(resolved_target, root_resolved):
        return None
    return ExternalSymlink(link.relative_to(root_resolved), raw_target, resolved_target)


def find_external_symlinks(root: Path) -> list[ExternalSymlink]:
    root_resolved = root.resolve(strict=False)
    symlinks: list[ExternalSymlink] = []

    for dirpath_str, dirnames, filenames in os.walk(root_resolved):
        dirpath = Path(dirpath_str)

        for name in list(dirnames):
            path = dirpath / name
            if path.is_symlink():
                link = maybe_external_symlink(root_resolved, path)
                if link is not None:
                    symlinks.append(link)
                dirnames.remove(name)
            elif should_prune_symlink_scan_dir(path):
                dirnames.remove(name)

        for name in filenames:
            path = dirpath / name
            if path.is_symlink():
                link = maybe_external_symlink(root_resolved, path)
                if link is not None:
                    symlinks.append(link)

    return sorted(symlinks, key=lambda link: link.relpath.as_posix())


def symlink_key(link: ExternalSymlink) -> tuple[Path, Path]:
    return link.relpath, link.resolved_target


def is_system_symlink_target(path: Path) -> bool:
    return any(path == root or is_within(path, root) for root in SYSTEM_SYMLINK_TARGET_ROOTS)


def external_symlink_map(root: Path) -> dict[tuple[Path, Path], ExternalSymlink]:
    return {symlink_key(link): link for link in find_external_symlinks(root)}


def find_bootstrap_external_symlinks(source_root: Path) -> list[ExternalSymlink]:
    return [
        link
        for link in find_external_symlinks(source_root)
        if is_git_ignored(source_root, link.relpath)
        and link.resolved_target.exists()
        and not is_system_symlink_target(link.resolved_target)
    ]


def find_shared_external_symlinks(
    source_root: Path,
    existing_roots: list[Path],
) -> list[ExternalSymlink]:
    if len(existing_roots) < MIN_SHARED_SYMLINK_WORKTREES:
        return find_bootstrap_external_symlinks(source_root)

    source_links = external_symlink_map(source_root)
    shared_counts: dict[tuple[Path, Path], int] = {}

    for root in existing_roots:
        for key in external_symlink_map(root):
            shared_counts[key] = shared_counts.get(key, 0) + 1

    return [
        link
        for key, link in sorted(source_links.items(), key=lambda item: item[0][0].as_posix())
        if shared_counts.get(key, 0) >= MIN_SHARED_SYMLINK_WORKTREES
    ]


def target_for_new_symlink(link: ExternalSymlink, new_link: Path) -> str:
    raw_target = Path(link.raw_target)
    if raw_target.is_absolute():
        return link.raw_target

    raw_target_from_new_link = resolved_symlink_target(new_link, link.raw_target)
    if raw_target_from_new_link == link.resolved_target:
        return link.raw_target
    return str(link.resolved_target)


def symlink_points_to(link: Path, target: Path) -> bool:
    try:
        raw_target = os.readlink(link)
    except OSError:
        return False
    return resolved_symlink_target(link, raw_target) == target


def recreate_external_symlinks(
    source_root: Path,
    existing_roots: list[Path],
    worktree: Path,
) -> list[Path]:
    created: list[Path] = []
    for link in find_shared_external_symlinks(source_root, existing_roots):
        new_link = worktree / link.relpath
        if new_link.is_symlink() and symlink_points_to(new_link, link.resolved_target):
            continue
        if new_link.exists() or new_link.is_symlink():
            print(
                f"Warning: skipping existing path while recreating symlink: {new_link}",
                file=sys.stderr,
            )
            continue
        new_link.parent.mkdir(parents=True, exist_ok=True)
        os.symlink(target_for_new_symlink(link, new_link), new_link)
        created.append(link.relpath)
    return created


def is_python_script(path: Path) -> bool:
    if path.suffix.lower() == ".py":
        return True
    try:
        head = path.read_bytes()[:80]
    except OSError:
        return False
    if not head.startswith(b"#!"):
        return False
    return b"python" in head.lower()


def resolve_git_sub(worktree_script: Path) -> Path | None:
    raw = os.environ.get("GIT_SUB", "").strip()
    if raw:
        p = Path(raw).expanduser().resolve()
        if p.is_file():
            return p
        die(f"GIT_SUB is set but not a file: {raw!r}")

    w = shutil.which("git-sub")
    if w:
        return Path(w).resolve()

    sibling = worktree_script.resolve().parent.parent / "git-sub" / "git-sub"
    if sibling.is_file():
        return sibling.resolve()

    return None


def run_git_sub(script: Path, worktree: Path) -> None:
    cmd = [sys.executable, str(script)] if is_python_script(script) else [str(script)]
    subprocess.run(cmd, cwd=worktree, check=True)


def submodule_fallback(worktree: Path) -> None:
    r = subprocess.run(
        ["git", "submodule", "update", "--init", "--recursive", "--recommend-shallow"],
        cwd=worktree,
        capture_output=True,
        text=True,
    )
    if r.returncode == 0:
        return
    err = ((r.stderr or "") + (r.stdout or "")).lower()
    if "unknown option" in err or "recommend-shallow" in err:
        git_run(["submodule", "update", "--init", "--recursive"], cwd=worktree)
        return
    print(r.stderr or r.stdout or f"git submodule failed ({r.returncode})", file=sys.stderr)
    raise SystemExit(r.returncode)


def after_worktree_add(
    source_root: Path,
    existing_roots: list[Path],
    worktree: Path,
    worktree_script: Path,
) -> None:
    gs = resolve_git_sub(worktree_script)
    if gs is not None:
        run_git_sub(gs, worktree)
    else:
        submodule_fallback(worktree)
    created_links = recreate_external_symlinks(source_root, existing_roots, worktree)
    if created_links:
        print("Recreated external symlinks:")
        for link in created_links:
            print(f"  {link}")


def cmd_add(branch: str, worktree_script: Path) -> None:
    root = repo_root()
    existing_roots = git_worktree_roots()
    wt = worktree_path(root, branch)
    if wt.exists():
        die(f"Error: target path already exists: {wt}")

    if ref_exists(f"refs/heads/{branch}"):
        git_run(["worktree", "add", str(wt), branch])
    elif ref_exists(f"refs/remotes/origin/{branch}"):
        git_run(["worktree", "add", "-b", branch, str(wt), f"origin/{branch}"])
    else:
        git_run(["worktree", "add", "-b", branch, str(wt)])

    after_worktree_add(root, existing_roots, wt, worktree_script)
    print("Created worktree:")
    print(f"  {wt}")


def cmd_remove(branch: str) -> None:
    root = repo_root()
    wt = worktree_path(root, branch)
    roots = git_worktree_roots()
    if wt.resolve(strict=False) not in {p.resolve(strict=False) for p in roots}:
        print(f"Error: no managed worktree for {branch!r} (expected {wt})", file=sys.stderr)
        print_rm_hint(root, roots, file=sys.stderr)
        raise SystemExit(1)
    git_run(["worktree", "remove", "-f", str(wt)])
    print("Removed worktree:")
    print(f"  {wt}")


def cmd_list() -> None:
    root = repo_root()
    git_run(["worktree", "list"])
    print_rm_hint(root)


def parse_argv(argv: list[str]) -> tuple[str, str | None]:
    if not argv:
        die(USAGE)
    if argv[0] in ("-h", "--help"):
        print(HELP)
        raise SystemExit(0)
    mode: str
    if argv[0] in ("list", "ls"):
        if len(argv) != 1:
            die(USAGE)
        return "list", None
    if argv[0] == "add":
        mode = "add"
        rest = argv[1:]
    elif argv[0] in ("remove", "rm"):
        mode = "remove"
        rest = argv[1:]
    else:
        die(USAGE)
    if len(rest) != 1:
        die(USAGE)
    branch = rest[0]
    if not branch.strip():
        die("Error: branch name must not be empty")
    return mode, branch


def main(argv: list[str] | None = None) -> int:
    worktree_script = Path(__file__).resolve()
    mode, branch = parse_argv(list(sys.argv[1:] if argv is None else argv))
    if mode == "list":
        cmd_list()
    elif mode == "remove":
        assert branch is not None
        cmd_remove(branch)
    else:
        assert branch is not None
        cmd_add(branch, worktree_script)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
